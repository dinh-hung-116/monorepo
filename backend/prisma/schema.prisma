// Task 2.1: bảng sản phẩm cho menu BrewLite. Tên bảng/cột viết snake_case.
// Task 6 & Task 7: bảng tài khoản người dùng (users), đơn hàng (orders) và chi tiết đơn (order_items).
// Đổi cấu trúc bảng: sửa file này → `npx prisma migrate dev --name ten_thay_doi`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  PENDING
  PAID
  PAYMENT_FAILED
  CANCELLED
  PREPARING
  READY
  COMPLETED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum UserRole {
  CUSTOMER
  STAFF
  ADMIN
}

model products {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(150)
  description  String?
  price        Decimal  @db.Decimal(12, 2)
  image_url    String?  @db.VarChar(500)
  category     String?  @db.VarChar(100)
  is_available Boolean  @default(true)
  created_at   DateTime @default(now()) @db.Timestamp(6)
  updated_at   DateTime @updatedAt @db.Timestamp(6)

  order_items order_items[]
  recipe      recipes?
  promotions  promotion_products[]
}

model users {
  id             Int      @id @default(autoincrement())
  email          String   @unique @db.VarChar(150)
  password_hash  String   @db.VarChar(255)
  name           String   @db.VarChar(150)
  phone          String?  @db.VarChar(20)
  role           UserRole @default(CUSTOMER)
  loyalty_points Int      @default(0)
  created_at     DateTime @default(now()) @db.Timestamp(6)
  updated_at     DateTime @updatedAt @db.Timestamp(6)

  orders                orders[]
  loyalty_transactions  loyaltytransactions[]
}

model orders {
  id             Int      @id @default(autoincrement())
  order_code     String   @unique @db.VarChar(50)
  user_id        Int?
  status         OrderStatus @default(PENDING)
  total_price    Decimal  @db.Decimal(12, 2)
  created_at     DateTime @default(now()) @db.Timestamp(6)
  updated_at     DateTime @updatedAt @db.Timestamp(6)

  promotion_id    Int?     @db.Integer
  discount_amount Decimal  @default(0) @db.Decimal(12, 2)

  user                  users?                 @relation(fields: [user_id], references: [id], onDelete: SetNull)
  items                 order_items[]
  payments              payments[]
  loyalty_transactions  loyaltytransactions[]
  promotion             promotions?            @relation(fields: [promotion_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([status])
  @@index([created_at])
  @@index([promotion_id])
}

model order_items {
  id           Int      @id @default(autoincrement())
  order_id     Int
  product_id   Int?
  product_name String   @db.VarChar(150)
  size         String   @db.VarChar(10)
  price        Decimal  @db.Decimal(12, 2)
  quantity     Int      @default(1)
  subtotal     Decimal  @db.Decimal(12, 2)

  order        orders    @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product      products? @relation(fields: [product_id], references: [id], onDelete: SetNull)
  item_toppings order_item_toppings[]

  @@index([order_id])
  @@index([product_id])
}

model toppings {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(100)
  price        Decimal  @db.Decimal(12, 2)
  is_available Boolean  @default(true)
  created_at   DateTime @default(now()) @db.Timestamp(6)
  updated_at   DateTime @updatedAt @db.Timestamp(6)

  order_items order_item_toppings[]
}

model order_item_toppings {
  id             Int      @id @default(autoincrement())
  order_item_id  Int
  topping_id     Int?
  topping_name   String   @db.VarChar(100)
  price          Decimal  @db.Decimal(12, 2)

  order_item order_items @relation(fields: [order_item_id], references: [id], onDelete: Cascade)
  topping    toppings?   @relation(fields: [topping_id], references: [id], onDelete: SetNull)

  @@index([order_item_id])
  @@index([topping_id])
}

model recipes {
  id           Int      @id @default(autoincrement())
  product_id   Int      @unique
  created_at   DateTime @default(now()) @db.Timestamp(6)
  updated_at   DateTime @updatedAt @db.Timestamp(6)

  product     products           @relation(fields: [product_id], references: [id], onDelete: Cascade)
  ingredients recipe_ingredients[]
}

model ingredients {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(150)
  unit        String   @db.VarChar(30)
  quantity    Decimal  @db.Decimal(12, 3)
  reserved    Decimal  @default(0) @db.Decimal(12, 3)
  created_at  DateTime @default(now()) @db.Timestamp(6)
  updated_at  DateTime @updatedAt @db.Timestamp(6)

  recipes  recipe_ingredients[]
}

model recipe_ingredients {
  id            Int     @id @default(autoincrement())
  recipe_id     Int
  ingredient_id Int
  quantity      Decimal @db.Decimal(12, 3)

  recipe     recipes     @relation(fields: [recipe_id], references: [id], onDelete: Cascade)
  ingredient ingredients @relation(fields: [ingredient_id], references: [id], onDelete: Cascade)

  @@unique([recipe_id, ingredient_id])
  @@index([ingredient_id])
}

model payments {
  id              Int       @id @default(autoincrement())
  order_id        Int
  idempotencyKey  String    @unique @db.VarChar(100)
  payment_method  String    @db.VarChar(50)
  amount          Decimal   @db.Decimal(12, 2)
  status          PaymentStatus    @default(PENDING)
  bank_code       String?   @db.VarChar(20)
  created_at      DateTime  @default(now()) @db.Timestamp(6)
  updated_at      DateTime  @updatedAt @db.Timestamp(6)

  order orders @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@index([order_id])
  @@index([status])
  @@index([created_at])
}

model loyaltytransactions {
  id               Int      @id @default(autoincrement())
  user_id          Int
  order_id         Int?
  points           Int
  created_at       DateTime @default(now()) @db.Timestamp(6)

  user  users   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  order orders? @relation(fields: [order_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([order_id])
  @@index([created_at])
}

model promotions {
  id              Int       @id @default(autoincrement())
  name            String    @db.VarChar(150)
  description     String?
  promo_code      String?   @unique @db.VarChar(50)

  discount_type   String    @db.VarChar(30)
  discount_value  Decimal   @db.Decimal(12, 2)

  min_order_value Decimal?  @db.Decimal(12, 2)
  max_discount    Decimal?  @db.Decimal(12, 2)

  usage_limit     Int?
  usage_count     Int       @default(0)

  start_date      DateTime  @db.Timestamp(6)
  end_date        DateTime  @db.Timestamp(6)

  is_active       Boolean   @default(true)

  created_at      DateTime  @default(now()) @db.Timestamp(6)
  updated_at      DateTime  @updatedAt @db.Timestamp(6)

  products        promotion_products[]
  orders          orders[]

  @@index([is_active])
  @@index([start_date, end_date])
}

// Bảng trung gian: khuyến mãi áp dụng cho những sản phẩm nào.
model promotion_products {
  promotion_id Int
  product_id   Int

  promotion promotions @relation(fields: [promotion_id], references: [id], onDelete: Cascade)
  product   products   @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@id([promotion_id, product_id])
  @@index([product_id])
}